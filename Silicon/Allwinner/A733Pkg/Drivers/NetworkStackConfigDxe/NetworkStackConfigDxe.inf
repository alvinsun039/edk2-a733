[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = NetworkStackConfigDxe
  FILE_GUID                      = 4A7330D2-4E54-53A7-61C6-4E4649473158
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = NetworkStackConfigInitialize

[Sources]
  NetworkStackConfigDxe.c
  NetworkStackConfigDxeHii.uni
  NetworkStackConfigDxeHii.vfr

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  Silicon/Allwinner/A733Pkg/A733Pkg.dec

[LibraryClasses]
  DebugLib
  DevicePathLib
  HiiLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiRuntimeServicesTableLib

[Protocols]
  gNetworkStackEnabledProtocolGuid         ## PRODUCES
  gNetworkStackIpv4EnabledProtocolGuid     ## PRODUCES
  gNetworkStackIpv6EnabledProtocolGuid     ## PRODUCES
  gNetworkStackPxeBootEnabledProtocolGuid  ## PRODUCES
  gNetworkStackHttpBootEnabledProtocolGuid ## PRODUCES

[Guids]
  gNetworkStackConfigFormSetGuid

[Pcd]
  gA733TokenSpaceGuid.PcdNetworkStackEnabledDefault
  gA733TokenSpaceGuid.PcdNetworkStackIpv4EnabledDefault
  gA733TokenSpaceGuid.PcdNetworkStackIpv6EnabledDefault
  gA733TokenSpaceGuid.PcdNetworkStackPxeBootEnabledDefault
  gA733TokenSpaceGuid.PcdNetworkStackHttpBootEnabledDefault

[Depex]
  TRUE