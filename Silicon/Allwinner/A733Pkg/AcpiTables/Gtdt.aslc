/** @file
*  Generic Timer Description Table (GTDT) — Allwinner A733
*
*  Arch timer only, PlatformTimerCount = 0: the A733 WDT
*  (allwinner,wdt-v103) is not SBSA, so it has no ACPI table and stays
*  with the firmware's SunxiWdtResetSystemLib.
*
*  GSIV mapping (BSP DTS timer_arch, PPI + 16, level-low):
*    Secure-EL1 phys   PPI 13 -> GSIV 29
*    Non-secure EL1    PPI 14 -> GSIV 30
*    Virtual           PPI 11 -> GSIV 27
*    Hypervisor (PL2)  PPI 10 -> GSIV 26
*
*  Syntax, revision and field layout follow the rk3588 template
*  (edk2-rockchip Gtdt.aslc).
*
*  Portions derived from edk2-a733 (github.com/vehoelite/edk2-a733),
*  Copyright (c) 2026 carpi-os contributors, BSD-2-Clause-Patent.
*  SPDX-License-Identifier: BSD-2-Clause-Patent
**/

#include <AcpiHelperMacros.h>
#include <IndustryStandard/Acpi.h>

#include "AcpiTables.h"

//
// GTDT timer flags: level-triggered (bit0 = 0) + active-low (bit1 = 1),
// Matches the DTS flags 0xf08 (IRQ_TYPE_LEVEL_LOW).
//
#define GTDT_TIMER_LEVEL_TRIGGERED  0
#define GTDT_TIMER_ACTIVE_LOW       EFI_ACPI_6_3_GTDT_TIMER_FLAG_TIMER_INTERRUPT_POLARITY

#define GTDT_GTIMER_FLAGS  (GTDT_TIMER_ACTIVE_LOW | GTDT_TIMER_LEVEL_TRIGGERED)

#pragma pack (1)

typedef struct {
  EFI_ACPI_6_3_GENERIC_TIMER_DESCRIPTION_TABLE    Gtdt;
} GENERIC_TIMER_DESCRIPTION_TABLE;

#pragma pack ()

GENERIC_TIMER_DESCRIPTION_TABLE  Gtdt = {
  {
    ACPI_HEADER (
      EFI_ACPI_6_3_GENERIC_TIMER_DESCRIPTION_TABLE_SIGNATURE,
      GENERIC_TIMER_DESCRIPTION_TABLE,
      EFI_ACPI_6_3_GENERIC_TIMER_DESCRIPTION_TABLE_REVISION
      ),
    0,                    // UINT64  CntControlBasePhysicalAddress (no MMIO control block; Flags 0)
    0,                    // UINT32  Reserved
    29,                   // UINT32  SecurePL1TimerGSIV      (PPI 13 + 16)
    GTDT_GTIMER_FLAGS,    // UINT32  SecurePL1TimerFlags
    30,                   // UINT32  NonSecurePL1TimerGSIV   (PPI 14 + 16)
    GTDT_GTIMER_FLAGS,    // UINT32  NonSecurePL1TimerFlags
    27,                   // UINT32  VirtualTimerGSIV        (PPI 11 + 16)
    GTDT_GTIMER_FLAGS,    // UINT32  VirtualTimerFlags
    26,                   // UINT32  NonSecurePL2TimerGSIV   (PPI 10 + 16)
    GTDT_GTIMER_FLAGS,    // UINT32  NonSecurePL2TimerFlags
    0xFFFFFFFFFFFFFFFF,   // UINT64  CntReadBasePhysicalAddress (no separate read base)
    0,                    // UINT32  PlatformTimerCount (no SBSA WDT)
    0,                    // UINT32  PlatformTimerOffset
    0,                    // UINT32  VirtualPL2TimerGSIV
    0                     // UINT32  VirtualPL2TimerFlags
  },
};

//
// Reference the table being generated to prevent the optimizer
// from removing the data structure from the executable
//
VOID *CONST  ReferenceAcpiTable = &Gtdt;
