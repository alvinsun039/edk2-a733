/** @file
*  Debug Port 2 Table (DBG2) — Allwinner A733
*
*  One serial debug port: UART0 at 0x02500000, the same port SPCR and the
*  DSDT's URT0 describe.  The table tells a debug-aware OS (Windows'
*  kdnet/serial debug, Linux's earlycon fallback) where the firmware
*  console lives without having to parse SPCR.
*
*  Layout, all offsets from the start of the device-information structure:
*    + 0x00  EFI_ACPI_DBG2_DEBUG_DEVICE_INFORMATION_STRUCT
*    + 0x16  namespace string "\_SB.URT0" (10 bytes with the NUL)
*    + 0x20  base address GAS (system memory, 32-bit, DWORD access)
*    + 0x2C  address size, UINT32 (0x400)
*
*  Portions derived from edk2-a733 (github.com/vehoelite/edk2-a733),
*  Copyright (c) 2026 carpi-os contributors, BSD-2-Clause-Patent.
*  SPDX-License-Identifier: BSD-2-Clause-Patent
**/

#include <Uefi.h>

#include <IndustryStandard/Acpi.h>
#include <IndustryStandard/DebugPort2Table.h>

#include "AcpiTables.h"

#pragma pack(push, 1)

typedef struct {
  EFI_ACPI_DEBUG_PORT_2_DESCRIPTION_TABLE          Header;
  EFI_ACPI_DBG2_DEBUG_DEVICE_INFORMATION_STRUCT    Device;
  CHAR8                                            NamespaceString[10];
  EFI_ACPI_6_3_GENERIC_ADDRESS_STRUCTURE           BaseAddress;
  UINT32                                           AddressSize;
} A733_DBG2_TABLE;

#pragma pack(pop)

STATIC A733_DBG2_TABLE  Dbg2 = {
  {
    //
    // Header length is the whole table (header + device info + strings +
    // registers), not just the fixed header, so it is spelled out instead
    // of using ACPI_HEADER().
    //
    {
      EFI_ACPI_6_3_DEBUG_PORT_2_TABLE_SIGNATURE,
      sizeof (A733_DBG2_TABLE),
      EFI_ACPI_DEBUG_PORT_2_TABLE_REVISION,
      0,                                               // Checksum, patched by AcpiTableDxe
      EFI_ACPI_OEM_ID,
      EFI_ACPI_OEM_TABLE_ID,
      EFI_ACPI_OEM_REVISION,
      EFI_ACPI_CREATOR_ID,
      EFI_ACPI_CREATOR_REVISION
    },
    sizeof (EFI_ACPI_DEBUG_PORT_2_DESCRIPTION_TABLE),  // OffsetDbgDeviceInfo
    1                                                  // NumberDbgDeviceInfo
  },
  {
    EFI_ACPI_DBG2_DEBUG_DEVICE_INFORMATION_STRUCT_REVISION,
    sizeof (A733_DBG2_TABLE) - sizeof (EFI_ACPI_DEBUG_PORT_2_DESCRIPTION_TABLE),
    1,                                                 // NumberofGenericAddressRegisters
    sizeof (Dbg2.NamespaceString),                     // NameSpaceStringLength
    OFFSET_OF (A733_DBG2_TABLE, NamespaceString) -
    OFFSET_OF (A733_DBG2_TABLE, Device),               // NameSpaceStringOffset
    0,                                                 // OemDataLength
    0,                                                 // OemDataOffset
    EFI_ACPI_DBG2_PORT_TYPE_SERIAL,
    EFI_ACPI_DBG2_PORT_SUBTYPE_SERIAL_FULL_16550,
    { EFI_ACPI_RESERVED_BYTE, EFI_ACPI_RESERVED_BYTE },
    OFFSET_OF (A733_DBG2_TABLE, BaseAddress) -
    OFFSET_OF (A733_DBG2_TABLE, Device),               // BaseAddressRegisterOffset
    OFFSET_OF (A733_DBG2_TABLE, AddressSize) -
    OFFSET_OF (A733_DBG2_TABLE, Device)                // AddressSizeOffset
  },
  "\\_SB.URT0",
  {
    EFI_ACPI_6_3_SYSTEM_MEMORY,
    32,                                                // RegisterBitWidth
    0,                                                 // RegisterBitOffset
    EFI_ACPI_6_3_DWORD,
    0x02500000                                         // Address
  },
  0x00000400                                           // AddressSize
};

//
// Reference the table being generated to prevent the optimizer from removing
// the data structure from the executable
//
VOID *CONST  ReferenceAcpiTable = &Dbg2;