#/** @file
#
#  ACPI table data and ASL sources required to boot the platform.
#
#  FILE_GUID 7E374E25-8E01-4FEE-87F2-390C23C606CD is the well-known
#  "ACPI tables in FV" GUID that AcpiPlatformDxe searches for with
#  LocateAndInstallAcpiFromFvConditional (same as edk2-rockchip boards).
#
#  Copyright (c) 2019-2021, ARM Limited. All rights reserved.
#  Copyright (c) Microsoft Corporation. All rights reserved.
#
#  Portions derived from edk2-a733 (github.com/vehoelite/edk2-a733),
#  Copyright (c) 2026 carpi-os contributors, BSD-2-Clause-Patent.
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#
#**/

[Defines]
  INF_VERSION                    = 0x0001001A
  BASE_NAME                      = AcpiTables
  FILE_GUID                      = 7E374E25-8E01-4FEE-87F2-390C23C606CD
  MODULE_TYPE                    = USER_DEFINED
  VERSION_STRING                 = 1.0

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = AARCH64
#

[Sources]
  DsdtCommon.asl
  Dbg2.aslc
  Fadt.aslc
  Gtdt.aslc
  Madt.aslc
  # Mcfg.aslc is deliberately NOT built: the A733 root port has no ECAM, so
  # the MCFG is a header-only skeleton — and GenFw rejects MCFG tables whose
  # Length is not greater than the 44-byte minimum (header + 8), i.e. a table
  # with zero ConfigSpace entries cannot pass.  Leave the file in the tree
  # until real ECAM support lands; ACPI-mode OSes simply see no MCFG.
  Pptt.aslc
  Spcr.aslc

[Packages]
  MdePkg/MdePkg.dec
  Silicon/Allwinner/A733Pkg/A733Pkg.dec

[FixedPcd]
  gA733TokenSpaceGuid.PcdA733UartBase
  gA733TokenSpaceGuid.PcdA733GicDistBase
  gA733TokenSpaceGuid.PcdA733GicRedistBase
