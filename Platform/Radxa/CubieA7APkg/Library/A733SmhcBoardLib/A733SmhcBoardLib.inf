## @file
#  The Radxa Cubie A7A's SMHC controller table.
#
#  Board data, not driver code: which SMHC controllers this board wires, where
#  each one is, which interrupt and CCU module belong to it, which pads carry it
#  and what kind of card sits on it.  A733SmhcDxe is driven from the table
#  A733SmhcBoardControllers returns and publishes one pass-thru handle per
#  entry; see Include/Library/A733SmhcBoardLib.h for the rules that shape it.
#
#  Copyright (c) 2026, edk2-a733 contributors.
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = A733SmhcBoardLib
  FILE_GUID      = b2c3d4e5-6f70-4182-93a4-a7a000000010
  MODULE_TYPE    = BASE
  VERSION_STRING = 1.0
  LIBRARY_CLASS  = A733SmhcBoardLib

[Sources]
  A733SmhcBoardLib.c

[Packages]
  MdePkg/MdePkg.dec
  Platform/Radxa/CubieA7APkg/CubieA7A.dec
  Silicon/Allwinner/A733Pkg/A733Pkg.dec

[LibraryClasses]
  A733GpioLib